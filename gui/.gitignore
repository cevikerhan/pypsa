version: '3.9'

services:
  pypsa-studio-backend:
    image: python:3.12-slim
    working_dir: /app
    volumes:
      - ./gui/backend:/app
    command: bash -lc "pip install -r requirements.txt && uvicorn main:app --host 0.0.0.0 --port 8000 --reload"
    ports:
      - "8000:8000"

  pypsa-studio-frontend:
    image: node:20-alpine
    working_dir: /app
    volumes:
      - ./gui/frontend:/app
    command: bash -lc "npm install && npm run dev -- --host 0.0.0.0 --port 5173"
    ports:
      - "5173:5173"
    depends_on:
      - pypsa-studio-backend

